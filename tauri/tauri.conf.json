{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cfopt-gui",
  "version": "0.1.0",
  "identifier": "com.cfopt.gui",
  "build": {
    "frontendDist": "../src/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../src run dev",
    "beforeBuildCommand": "npm --prefix ../src run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "cfopt GUI",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/cfopt-go"
    ]
  },
  "plugins": {}
}
