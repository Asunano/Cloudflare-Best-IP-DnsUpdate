# 运行时生成的配置文件（用户自定义）
conf/*.json
conf/*.conf
!conf/**/*.example
conf/history.jsonl
cmd/conf/*.json

# 日志文件
logs/
*.log

# 运行时数据目录（测速结果、IP 列表等，任意层级）
**/assets/data/

# IP 源文件数量侧车
**/*.count

# cfst 程序二进制文件
**/assets/cfst/cfst-*

# 临时文件
*.tmp
*.temp
*~
*.bak
*.orig
*.rej

# Go 测试临时目录（TMPDIR 重定向产物，任意层级）
**/.gotmp-*

# 系统文件
.DS_Store
Thumbs.db

# IDE 和编辑器配置
.lingma/
.vscode/
.idea/

# ===== Go 编译产物 =====
cfopt
cfopt.exe

# ===== Tauri GUI 构建产物 =====
/tauri/binaries/

# IPC 端口发现文件
cfopt.ipc

# SvelteKit 前端构建产物
/src/build/

.codebuddy/
nul
.workbuddy/

# 一次性分析/审计 scratch 报告
GO_VS_BASH_GAP_REPORT*.md

# 本地 AI 指令（仅本地使用，不入库）
CODEBUDDY.md
