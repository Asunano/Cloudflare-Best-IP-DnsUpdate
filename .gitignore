# 运行时生成的配置文件（用户自定义）
conf/*.json
conf/status.conf
conf/history.jsonl
conf/deployments.json

# 运行时标记文件
.restart_needed
.restart_count

# 日志文件
logs/
*.log

# 锁文件（匹配所有模块下的 .*.lock 文件）
modules/**/*.lock

# 部署版本特有的模块（原始仓库函数内联在 cfopt.sh 中）
modules/install/

# 运行时数据目录（测速结果、IP 列表等，任意层级）
**/assets/data/

# IP 源文件数量侧车（<ipfile>.count，由时效性/数量变化检测写入，不入库）
**/*.count

# cfst 程序二进制文件（sidecar，按 assets/cfst/cfst-<goos>-<goarch>[.exe] 探测，不入库）
assets/cfst/cfst
**/assets/cfst/cfst-*

# 临时文件
*.tmp
*.temp
*~

# 系统文件
.DS_Store
Thumbs.db

# IDE 和编辑器配置
.lingma/
.vscode/
.idea/

# ===== Go 重写版（cfopt-go）与 Tauri GUI 构建产物 =====
# Go 编译产物（cfopt-go 目录下）
/cfopt-go/cfopt-go
/cfopt-go/cfopt-go.exe

# Tauri sidecar 二进制（由 scripts/setup-sidecar 生成，不入库）
/tauri/binaries/

# cfopt-go 运行时配置（用户自定义，含凭据，不入库；保留 *.example 模板）
/cfopt-go/conf/**/*.json
/cfopt-go/conf/**/*.conf
!/cfopt-go/conf/**/*.example
# cfopt-go IPC 端口发现文件
/cfopt-go/cfopt.ipc

# SvelteKit 前端构建产物
/src/build/
.codebuddy/
nul
.workbuddy/

# 一次性分析/审计 scratch 报告（不入库）
GO_VS_BASH_GAP_REPORT*.md