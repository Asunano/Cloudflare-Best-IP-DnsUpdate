classDiagram
    %% ===== 可挂载 DNS 模块架构（internal/dns + internal/sync） =====

    class SyncModule {
        <<interface>>
        +ID() string
        +Enabled(cfg *config.Config) bool
        +IPSourceFiles(cfg *config.Config) []string
        +Sync(ctx context.Context, cfg *config.Config) (*SyncResult, error)
    }

    class Registry {
        -modules map~string,SyncModule~
        -order []string
        +NewRegistry() *Registry
        +Register(m SyncModule)
        +RegisterAll(ms []SyncModule)
        +Modules() []SyncModule
        +Get(id string) (SyncModule, bool)
    }

    class BuiltinModules {
        <<var>>
        +[]SyncModule = [cfModule{}, dnspodModule{}]
    }

    class cfModule {
        +ID() string
        +Enabled(cfg *config.Config) bool
        +IPSourceFiles(cfg *config.Config) []string
        +Sync(ctx, cfg) (*SyncResult, error)
    }

    class dnspodModule {
        +ID() string
        +Enabled(cfg *config.Config) bool
        +IPSourceFiles(cfg *config.Config) []string
        +Sync(ctx, cfg) (*SyncResult, error)
    }

    class DNSProvider {
        <<interface>>
        +ListRecords(ctx, domain) ([]Record, error)
        +UpsertRecord(ctx, domain, rec) error
        +DeleteRecord(ctx, domain, id) error
    }

    class CloudflareProvider {
        +Sync(ctx, *config.CFDNSConfig) (*SyncResult, error)
    }

    class DNSPodProvider {
        +Sync(ctx, *config.DNSPodConfig) (*SyncResult, error)
    }

    class Syncer {
        -tester speedtest.SpeedTester
        -registry *dns.Registry
        -history history.HistoryStore
        +NewSyncer(tester, registry, hist) *Syncer
        +BuildSyncerFromConfig(cfg, hist) (*Syncer, error)
        +SyncAll(ctx, cfg, onProgress, providers ...string) (*SyncSummary, error)
    }

    class SyncSummary {
        +best_ip_count int
        +updated int
        +created int
        +deleted int
        +errors []string
    }

    class SyncResult {
        +updated int
        +created int
        +deleted int
        +errors []string
    }

    class Config {
        +global *GlobalConfig
        +cf_ip *CFIPConfig
        +cf_dns *CFDNSConfig
        +dnspod *DNSPodConfig
        +modules map~string,json.RawMessage~
    }

    %% ---- 关系 ----
    SyncModule <|.. cfModule : implements
    SyncModule <|.. dnspodModule : implements
    Registry o-- SyncModule : holds(ordered)
    BuiltinModules ..> cfModule : contains
    BuiltinModules ..> dnspodModule : contains

    DNSProvider <|.. CloudflareProvider : implements
    DNSProvider <|.. DNSPodProvider : implements

    Syncer --> Registry : iterates Modules()
    Syncer --> SyncSummary : returns
    Syncer ..> SyncModule : calls Sync()
    cfModule ..> CloudflareProvider : NewCloudflareProvider().Sync
    dnspodModule ..> DNSPodProvider : NewDNSPodProvider().Sync
    SyncModule ..> SyncResult : returns
    Syncer ..> Config : reads
